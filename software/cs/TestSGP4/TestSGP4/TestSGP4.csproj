<Project Sdk="Microsoft.NET.Sdk">
  <!-- CONVERTED 5 oct 2026: old-style project -> SDK-style, dual-targeted for the .NET 10 migration.
       net10.0-windows is listed first so Visual Studio runs it by default (F5).
       Library HintPaths to bin\Debug\*.dll replaced with ProjectReferences; System.Deployment (ClickOnce-only) dropped.
       Pre-conversion version is in the backup / git baseline tag. -->
  <!-- CHANGED 29 oct 2026: console app with no windows dependencies now that SGP4Lib is plain net10.0
       (manual start/stop input is in Program.cs getmanualtimes) -->
  <!-- was x86 (32-bit). Now AnyCPU 64-bit on every solution platform: x86 .NET 10 apps need the separate x86 .NET runtime, and 64-bit keeps it consistent with the other apps -->
  <PropertyGroup>
    <!-- <TargetFrameworks>net10.0-windows;net48</TargetFrameworks> -->
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SGP4Methods</RootNamespace>
    <AssemblyName>TestSGP4</AssemblyName>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>
    <!-- 64-bit on both targets so net48/net10 comparisons differ only by runtime -->
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- keep the existing AssemblyInfo.cs rather than SDK-generated assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- include only the files listed below (same as the old project), so backup files in the folder are ignored -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SGP4Lib\SGP4Lib\SGP4Lib.csproj" />
  </ItemGroup>

  <!-- framework assemblies the old project referenced that are not SDK defaults on net48;
       on net10 these are all part of the shared framework -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>
</Project>
