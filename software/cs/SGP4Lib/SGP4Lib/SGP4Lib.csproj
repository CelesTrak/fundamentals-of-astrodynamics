<Project Sdk="Microsoft.NET.Sdk">
  <!-- CONVERTED 2 oct 2026: old-style net48 project -> SDK-style, multi-targeted for the .NET 10 migration.
       net48 is kept so existing consumers (incl. the ODTK density workflow) build and run unchanged.
       Pre-conversion version is in the backup / git baseline tag. -->
  <PropertyGroup>
    <!-- <TargetFrameworks>net48;net10.0-windows</TargetFrameworks> -->
    <!-- <UseWindowsForms>true</UseWindowsForms> -->
    <!-- CHANGED 29 oct 2026: InputBox moved out to the calling program, so no WinForms - plain net10.0 like the other
         computational libraries -->
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>SGP4Lib</RootNamespace>
    <AssemblyName>SGP4Lib</AssemblyName>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <Platforms>AnyCPU;x64</Platforms>
    <Deterministic>true</Deterministic>
    <!-- keep the existing AssemblyInfo.cs rather than SDK-generated assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- compile only the files listed below (same as the old project), so backup .cs files in the folder are ignored -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SGP4Lib.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- framework assemblies the old project referenced that are not SDK defaults on net48;
       on net10 these are all part of the shared framework -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>
</Project>
